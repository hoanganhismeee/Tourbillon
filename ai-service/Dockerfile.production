# Production AI service — calls the Anthropic API for generation and embeds in-process.
# No Ollama or CUDA; swap LLM_BASE_URL + LLM_MODEL env vars at runtime.
FROM python:3.12-slim

WORKDIR /app

# CPU-only torch. The default wheel pulls the full CUDA runtime — around 2 GB of drivers this
# image can never use, since there is no GPU here.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Bake the weights into the image. Downloading them on first request would make one unlucky
# user wait for a 400 MB fetch, and a container with no outbound access to Hugging Face would
# fail to embed at all with no obvious cause.
ARG LOCAL_EMBED_MODEL=sentence-transformers/all-mpnet-base-v2
ENV LOCAL_EMBED_MODEL=${LOCAL_EMBED_MODEL}
RUN python -c "from sentence_transformers import SentenceTransformer; import os; SentenceTransformer(os.environ['LOCAL_EMBED_MODEL'])"

COPY . .

EXPOSE 5000
CMD ["python", "app.py"]
